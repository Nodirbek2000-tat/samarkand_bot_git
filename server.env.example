# Bot — serverdagi .env (GitHub ga yuklanmaydi). Nusxa:  cp server.env.example .env

# @BotFather bergan token — hech kimga ko‘rsatmang
BOT_TOKEN=
# bot ishga tushganda xabar oladigan Telegram ID lar (vergul bilan, ixtiyoriy)
ADMINS=
ip=mentadbirkor.uz

# backend .env dagi BOT_API_SECRET bilan AYNAN bir xil
BOT_API_SECRET=
# xabarlardagi havolalar va «Davomini o‘qish» tugmasi shu manzilga olib boradi (https bo‘lishi shart)
SITE_URL=https://mentadbirkor.uz
# API_URL docker-compose.yml da beriladi (http://backend:8000/api) — bot saytga server ichidan murojaat qiladi
